MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=eldercare-analysis
MQTT_STATUS_TOPIC=eldercare/node01/status
MQTT_ANALYSIS_TOPIC=eldercare/node01/analysis
MQTT_ALARM_TOPIC=eldercare/node01/alarm
DB_PATH=/app/data/eldercare.db
LOG_LEVEL=INFO
LLM_ENABLED=auto
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=8
LLM_MIN_RISK=2
LLM_MIN_GAS=650
