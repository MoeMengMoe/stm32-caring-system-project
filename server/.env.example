# Copy this file to server/.env on the deployment machine.
# Do not commit server/.env.

# Leave OPENAI_API_KEY empty to disable model calls and use local rules only.
OPENAI_API_KEY=

# OpenAI-compatible chat completions endpoint.
# You can also set https://api.openai.com/v1; the service normalizes it to /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# PushPlus notification. Bind WeChat/email on the PushPlus platform, then set token here.
PUSHPLUS_ENABLED=false
PUSHPLUS_TOKEN=
PUSHPLUS_URL=https://www.pushplus.plus/send
PUSHPLUS_TOPIC=
PUSHPLUS_TEMPLATE=html
PUSHPLUS_CHANNEL=
PUSHPLUS_TIMEOUT_SECONDS=5
